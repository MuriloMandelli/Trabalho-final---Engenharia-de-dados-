Table populacao_municipio {
  municipio_id int [not null, ref: > municipio.id]
  ano int [not null]
  populacao int
  atualizado_em timestamp [not null]

  indexes {
    (municipio_id, ano) [pk]
  }
}

Table producao_agricola {
  municipio_id int [not null, ref: > municipio.id]
  ano int [not null]
  cultura_id int [not null]
  cultura_nome varchar(250)
  area_plantada_ou_destinada_a_colheita numeric
  area_plantada_ou_destinada_a_colheita_percentual_d numeric
  area_colhida numeric
  area_colhida_percentual_do_total_geral numeric
  quantidade_produzida numeric
  rendimento_medio_da_producao numeric
  valor_da_producao numeric
  valor_da_producao_percentual_do_total_geral numeric
  atualizado_em timestamp [not null]

  indexes {
    (municipio_id, ano, cultura_id) [pk]
  }
}

Table producao_origem_animal {
  municipio_id int [not null, ref: > municipio.id]
  ano int [not null]
  produto_id int [not null]
  produto_nome varchar(250)
  producao_de_origem_animal numeric
  valor_da_producao numeric
  valor_da_producao_percentual_do_total_geral numeric
  atualizado_em timestamp [not null]

  indexes {
    (municipio_id, ano, produto_id) [pk]
  }
}

Table rebanho_municipio {
  municipio_id int [not null, ref: > municipio.id]
  ano int [not null]
  tipo_rebanho_id int [not null]
  tipo_rebanho_nome varchar(250)
  efetivo_dos_rebanhos numeric
  atualizado_em timestamp [not null]

  indexes {
    (municipio_id, ano, tipo_rebanho_id) [pk]
  }
}
